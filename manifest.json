{
  "manifest_version": 3,
  "name": "AINS Studio Glasswing for Firefox",
  "version": "5.0.1",
  "description": "Glasswing brings AINS Studio reading tools and appearance controls to Firefox.",
  "action": {
    "default_title": "Open AINS Studio settings"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://ains.moe.gov.my/web/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{e08aba40-81c9-4544-a8b6-c585a72c2477}",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://ains.moe.gov.my/web/*"
      ],
      "js": [
        "browser-compat.js",
        "theme.js",
        "bulk-import.js",
        "studio-dashboard.js"
      ],
      "run_at": "document_start"
    }
  ]
}
